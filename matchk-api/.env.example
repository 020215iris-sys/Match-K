# ===== Mātch K API 환경변수 (실 키는 절대 커밋 금지 — 부록 C) =====

# DB (로컬 개발은 기본 sqlite, Railway 배포 시 PostgreSQL URL로 교체)
DATABASE_URL=sqlite:///./matchk.db

# 한국관광공사 TourAPI 서비스키 (공공데이터포털 발급, URL 인코딩 안 된 원본 키)
TOURAPI_KEY=

# JWT
JWT_SECRET=change-me-to-random-64-chars
JWT_EXPIRE_MINUTES=43200

# Google OAuth (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=                 # 웹 클라이언트 ID
GOOGLE_CLIENT_SECRET=             # 웹 클라이언트 시크릿
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# 모바일 로그인 검증용 (dev build 후 발급 — 없으면 aud 검사 생략)
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Papago 번역 (네이버클라우드 콘솔 발급) — 외국어판 없는 장소의 폴백 번역. 비우면 번역 생략.
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=

# Claude API — 검색 AI 추천어 생성 (search_suggest.py). 비우면 고정 샘플로 폴백.
ANTHROPIC_API_KEY=

# 시연 모드: true면 mock 좌표로 도장 허용 (시연 빌드 한정, 프로덕션 기본 false — D4 [B])
DEMO_MODE=false

# 도장 인정 GPS 반경 (미터)
GPS_RADIUS_M=100
