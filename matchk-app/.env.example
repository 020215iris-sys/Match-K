# Expo 공개 환경변수 (EXPO_PUBLIC_ 접두사만 앱 번들에 포함됨)
# ⚠️ TourAPI 키는 여기 넣지 말 것 — 백엔드에만 존재 (계획서 §4)

EXPO_PUBLIC_API_URL=http://localhost:8000

# Kakao JavaScript 키 (지도용). 카카오 개발자 콘솔에서 웹 플랫폼 도메인 등록 후
# 그 도메인을 KAKAO_BASE_URL에도 지정 (WebView baseUrl 우회 — D4 [A])
EXPO_PUBLIC_KAKAO_JS_KEY=
EXPO_PUBLIC_KAKAO_BASE_URL=https://matchk.example.com

# 구글 로그인 클라이언트 ID (Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
